{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Backend API Server",
      "type": "shell",
      "command": "python -m uvicorn backend.api:app --reload --port 8000",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🎨 Start Frontend Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
