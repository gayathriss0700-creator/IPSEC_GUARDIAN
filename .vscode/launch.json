{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "⚡ Run FastAPI Backend API (Port 8000)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.api:app",
        "--reload",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛡️ Run IPsec Assessment Pipeline CLI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/ipsec_security_assessment.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}